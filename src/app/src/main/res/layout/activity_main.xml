<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:elevation="2dp"
        android:background="#FFFFFF"
        android:orientation="horizontal">
        <LinearLayout
            android:id="@+id/tabVisits"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tabVisitsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                android:text="Visits"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View
                android:id="@+id/tabVisitsLine"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/ic_bg" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tabComms"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tabCommsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                android:text="Samtaler"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View
                android:id="@+id/tabCommsLine"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/ic_bg" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tabSettings"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tabSettingsLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                android:text="Settings"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View
                android:id="@+id/tabSettingsLine"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/ic_bg" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/tabLog"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="?android:attr/selectableItemBackground"
            android:clickable="true"
            android:focusable="true"
            android:orientation="vertical">
            <TextView
                android:id="@+id/tabLogLabel"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingTop="14dp"
                android:paddingBottom="12dp"
                android:text="Log"
                android:textAllCaps="true"
                android:textSize="14sp"
                android:textStyle="bold" />
            <View
                android:id="@+id/tabLogLine"
                android:layout_width="match_parent"
                android:layout_height="3dp"
                android:background="@color/ic_bg" />
        </LinearLayout>
    </LinearLayout>

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">

        <!-- Tab 1: status and visits -->
        <LinearLayout
            android:id="@+id/pageVisits"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:padding="16dp">
            <TextView
                android:id="@+id/status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:textSize="16sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/lastCheck"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:textSize="14sp" />
            <Button
                android:id="@+id/btnNow"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Check now" />
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:text="Visits:"
                android:textStyle="bold" />

            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1">
                <LinearLayout
                    android:id="@+id/visits"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />
            </ScrollView>
        </LinearLayout>

        <!-- Tab 2: settings -->
        <ScrollView
            android:id="@+id/pageSettings"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:padding="16dp">
                <TextView
                    android:id="@+id/settingsStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="12dp"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnStart"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Start logging" />
                    <Button
                        android:id="@+id/btnStop"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Stop logging" />
                </LinearLayout>
                <CheckBox
                    android:id="@+id/chkGpsOff"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Turn GPS on when needed before locating" />

                <TextView
                    android:id="@+id/gpsHint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="Turns GPS on if it's off, and turns it off again afterwards only if it was off"
                    android:textSize="12sp" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Check every (minutes):"
                        android:textSize="16sp" />
                    <Button
                        android:id="@+id/btnMinus"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="−" />
                    <EditText
                        android:id="@+id/editInterval"
                        android:layout_width="64dp"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:imeOptions="actionDone"
                        android:importantForAutofill="no"
                        android:hint="5"
                        android:inputType="number"
                        android:maxLength="4"
                        android:selectAllOnFocus="true" />
                    <Button
                        android:id="@+id/btnPlus"
                        android:layout_width="48dp"
                        android:layout_height="wrap_content"
                        android:text="+" />
                    <Button
                        android:id="@+id/btnApplyInterval"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apply" />
                </LinearLayout>

                <Button
                    android:id="@+id/btnBackground"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Allow location “all the time”" />

                <Button
                    android:id="@+id/btnBattery"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Turn off battery optimization" />

                <!-- Places (merge addresses), edited inline -->
                <TextView
                    android:id="@+id/placesTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Places (merge addresses)"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="One place per line: Name;address 1;address 2;…\nWhen the looked-up address matches one of the addresses (case and extra spaces are ignored), the name is logged instead.\nExample: Home;Example Street 1, 0000 Town;Other Road 2, 0000 Town"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
                <TextView
                    android:id="@+id/placesLastRaw"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/editPlaces"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="top|start"
                    android:hint="Home;Example Street 1, 0000 Town"
                    android:importantForAutofill="no"
                    android:inputType="textMultiLine|textNoSuggestions"
                    android:minLines="4"
                    android:scrollHorizontally="false"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnInsertLast"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Insert last address" />
                    <Button
                        android:id="@+id/btnSavePlaces"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save" />
                    <TextView
                        android:id="@+id/placesSaved"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/placeThumbs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical" />

                <!-- Street View images on the stop rows -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Street View"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/streetViewHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/editApiKey"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="Google API key"
                    android:importantForAutofill="no"
                    android:inputType="textPassword"
                    android:singleLine="true"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnSaveApiKey"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save" />
                    <TextView
                        android:id="@+id/apiKeyStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textSize="13sp" />
                </LinearLayout>

                <!-- 1.31: Google Maps / Ice Box state and the fallback browser for Street View -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/browserStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:textSize="13sp" />
                    <Button
                        android:id="@+id/btnBrowser"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="Browser…" />
                </LinearLayout>

                <!-- Optional: report the wireless-debugging address to a dashboard -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Dashboard URL"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:text="Optional. If set, the phone's wireless-debugging address (ip:port, or off) is sent to this URL when it changes and about once an hour. Read-only: nothing is turned on or off. Empty = off."
                    android:textSize="13sp" />
                <EditText
                    android:id="@+id/editDashboardUrl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="https://…/api/adbport"
                    android:importantForAutofill="no"
                    android:inputType="textUri"
                    android:singleLine="true"
                    android:textSize="14sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <Button
                        android:id="@+id/btnSaveDashboardUrl"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save" />
                    <TextView
                        android:id="@+id/dashboardStatus"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:layout_marginStart="8dp"
                        android:textIsSelectable="true"
                        android:textSize="13sp" />
                </LinearLayout>
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Dashbord-IP (reserve)"
                    android:textStyle="bold" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Used when the dashboard's host name cannot be resolved (DNS). HTTPS is still verified for the host name. Optional: the IP the host last resolved to is learned automatically."
                    android:textColor="#757575"
                    android:textSize="12sp" />
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">
                    <EditText
                        android:id="@+id/editDashboardIp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="IP address (empty = only learned IP)"
                        android:importantForAutofill="no"
                        android:inputType="textUri"
                        android:singleLine="true"
                        android:textSize="14sp" />
                    <Button
                        android:id="@+id/btnSaveDashboardIp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Save" />
                </LinearLayout>
                <TextView
                    android:id="@+id/dashboardIpStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
                <CheckBox
                    android:id="@+id/checkKeepAdbWifi"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Keep wireless debugging on (when on Wi-Fi)" />
                <TextView
                    android:id="@+id/keepAdbWifiStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
                <CheckBox
                    android:id="@+id/checkKeepTailscale"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Keep Tailscale on (ask it to connect when it is off; notify if it stays off)" />

                <!-- 1.32: calls and SMS -->
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:text="Samtaler og SMS"
                    android:textSize="16sp"
                    android:textStyle="bold" />
                <TextView
                    android:id="@+id/commPermStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:textIsSelectable="true"
                    android:textSize="13sp" />
                <Button
                    android:id="@+id/btnCommPermsSettings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Gi tilgang til samtaler, SMS og kontakter" />
                <Button
                    android:id="@+id/btnAppInfo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Åpne appinfo (begrensede innstillinger)" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Står det «Begrenset innstilling» / «Restricted setting» når du gir tilgang til SMS eller samtalelogg? Android begrenser det for apper som ikke er fra Play-butikken. Åpne appinfo, trykk ⋮ øverst til høyre og velg «Tillat begrensede innstillinger», og prøv igjen."
                    android:textColor="#757575"
                    android:textSize="12sp" />
                <CheckBox
                    android:id="@+id/checkCommPopup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Popup ved innkommende samtale/SMS/MMS (navn eller oppslag)" />
                <CheckBox
                    android:id="@+id/checkCommTts"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Les opp innringer/SMS/MMS (norsk tale)" />
                <CheckBox
                    android:id="@+id/checkCommTtsText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="Les også opp SMS- og MMS-teksten (ellers bare avsender)" />
                <Button
                    android:id="@+id/btnTtsTest"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="Test opplesing" />
                <CheckBox
                    android:id="@+id/checkLookup"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Slå opp ukjente nummer på 1881.no" />
                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:text="Bare nummeret sendes (norske 8-sifrede nummer som ikke er i kontakter). Svar lagres på telefonen. Maks 40 oppslag i timen."
                    android:textColor="#757575"
                    android:textSize="12sp" />
                <CheckBox
                    android:id="@+id/checkLookupContact"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Legg automatisk til oppslag i kontakter" />
                <TextView
                    android:id="@+id/lookupStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="32dp"
                    android:textSize="12sp" />
                <CheckBox
                    android:id="@+id/checkRecExperimental"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Eksperimentelt samtaleopptak i appen – tar trolig bare opp din egen stemme" />
                <TextView
                    android:id="@+id/recHelp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:textColor="#757575"
                    android:textSize="12sp" />

            </LinearLayout>
        </ScrollView>

        <!-- Tab 4 (1.32): calls, SMS and MMS -->
        <LinearLayout
            android:id="@+id/pageComms"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/chipAll"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:text="Alle" />
                <Button
                    android:id="@+id/chipCalls"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:text="Samtaler" />
                <Button
                    android:id="@+id/chipMsgs"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:textAllCaps="false"
                    android:text="SMS/MMS" />
                <Button
                    android:id="@+id/btnCommRefresh"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="⟳" />
            </LinearLayout>
            <TextView
                android:id="@+id/commInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#757575"
                android:textSize="12sp" />
            <Button
                android:id="@+id/btnCommPerms"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:text="Gi tilgang til samtaler, SMS og kontakter" />
            <ListView
                android:id="@+id/commList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp"
                android:fastScrollEnabled="true" />
        </LinearLayout>

        <!-- Tab 3: debug log (all entries, newest first) -->
        <LinearLayout
            android:id="@+id/pageLog"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:paddingStart="8dp"
            android:paddingEnd="8dp"
            android:paddingTop="8dp"
            android:visibility="gone">
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">
                <Spinner
                    android:id="@+id/logFilter"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1" />
                <Button
                    android:id="@+id/btnLogRefresh"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Oppdater" />
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">
                <Button
                    android:id="@+id/btnLogCopy"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Kopier" />
                <Button
                    android:id="@+id/btnLogShare"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Del" />
                <Button
                    android:id="@+id/btnLogClear"
                    style="?android:attr/buttonStyleSmall"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Tøm" />
            </LinearLayout>
            <TextView
                android:id="@+id/logCount"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingTop="4dp"
                android:paddingBottom="4dp"
                android:textColor="#757575"
                android:textSize="12sp" />
            <ListView
                android:id="@+id/logList"
                android:layout_width="match_parent"
                android:layout_height="0dp"
                android:layout_weight="1"
                android:divider="#E0E0E0"
                android:dividerHeight="1dp"
                android:fastScrollEnabled="true" />
        </LinearLayout>
    </FrameLayout>
</LinearLayout>
