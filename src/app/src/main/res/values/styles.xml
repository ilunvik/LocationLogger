<?xml version="1.0" encoding="utf-8"?>
<!-- 1.49: pill-shaped tonal buttons, text buttons and pages in the AudioAddict style -->
<resources>
    <style name="LL" />
    <style name="LL.Button" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_tonal</item>
        <item name="android:textColor">@color/btn_tonal_text</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:minWidth">48dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:elevation">0dp</item>
    </style>
    <style name="LL.Button.Small">
        <item name="android:textSize">13sp</item>
        <item name="android:minHeight">36dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
    </style>
    <!-- filled (primary) pill for the main action -->
    <style name="LL.Button.Filled">
        <item name="android:background">@drawable/btn_filled</item>
        <item name="android:textColor">@color/m3_on_primary</item>
    </style>
    <style name="LL.TextButton" parent="android:Widget.Material.Button.Borderless.Colored">
        <item name="android:textAllCaps">false</item>
        <item name="android:textColor">@color/m3_primary</item>
        <item name="android:fontFamily">sans-serif-medium</item>
    </style>
    <style name="LL.Popup" parent="android:Widget.Material.PopupMenu">
        <item name="android:popupBackground">@drawable/dialog_bg</item>
    </style>
    <style name="LL.Spinner" parent="android:Widget.Material.Spinner">
        <item name="android:popupBackground">@drawable/dialog_bg</item>
    </style>
    <!-- section headers on Settings -->
    <style name="LL.Section">
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textColor">@color/m3_primary</item>
        <item name="android:letterSpacing">0.04</item>
    </style>
    <style name="LL.Card">
        <item name="android:background">@drawable/card</item>
        <item name="android:padding">16dp</item>
        <item name="android:layout_marginTop">12dp</item>
    </style>
    <style name="LL.Hint">
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/m3_on_surface_variant</item>
    </style>
</resources>
